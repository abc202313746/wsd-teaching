{
  "info": {
    "name": "WSD Backend Assignment - 8 APIs",
    "description": "서버를 재시작한 뒤 0 - Setup, 1 - Eight APIs, 2 - Error responses 순서로 요청을 보낸다. 수정과 삭제 후에는 확인용 GET 요청으로 저장된 결과를 확인한다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "headerItemId",
      "value": ""
    },
    {
      "key": "fixtureId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Standard response envelope\", function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.keys(\"status\", \"data\");",
          "    pm.expect(body.status).to.eql(pm.response.code < 400 ? \"success\" : \"error\");",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 - Setup",
      "item": [
        {
          "name": "Create batch-delete fixture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Milk\",\n  \"price\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"fixtureId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 - Eight APIs",
      "item": [
        {
          "name": "POST 1 - Create item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coffee\",\n  \"price\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"itemId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST 2 - Create with headers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-USER-ID",
                "value": "student01",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer demo-token",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v3/items/with-header",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tea\",\n  \"price\": 2000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"headerItemId\", pm.response.json().data.item.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET 1 - Search and list",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items?page=0&size=10",
            "description": "검색 조건 없이 전체 목록을 조회한다. 검색을 확인할 때는 Params에 keyword를 추가한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET 2 - Read item",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items/{{itemId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT 1 - Replace item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items/{{itemId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Americano\",\n  \"price\": 1800\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Check 1 - Read after full update",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items/{{itemId}}",
            "description": "전체 수정 후 상품을 다시 조회해서 이름과 가격이 저장됐는지 확인한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Updated values are stored\", function () {",
                  "    const item = pm.response.json().data;",
                  "    pm.expect(item.id).to.eql(Number(pm.collectionVariables.get(\"itemId\")));",
                  "    pm.expect(item.name).to.eql(\"Americano\");",
                  "    pm.expect(item.price).to.eql(1800);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT 2 - Replace price",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items/{{itemId}}/price",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 2200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Check 2 - Read after price update",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items/{{itemId}}",
            "description": "가격 수정 후 상품을 다시 조회해서 가격과 기존 이름을 확인한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Price is stored and name is retained\", function () {",
                  "    const item = pm.response.json().data;",
                  "    pm.expect(item.id).to.eql(Number(pm.collectionVariables.get(\"itemId\")));",
                  "    pm.expect(item.name).to.eql(\"Americano\");",
                  "    pm.expect(item.price).to.eql(2200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE 1 - Delete item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items/{{headerItemId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Check 3 - Read deleted item",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items/{{headerItemId}}",
            "description": "삭제한 상품을 다시 조회해서 404 응답을 확인한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Deleted item is not found\", function () {",
                  "    pm.expect(pm.response.json().data.code).to.eql(\"ITEM_NOT_FOUND\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE 2 - Delete selected items",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items?ids={{itemId}},{{fixtureId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Check 4 - List after batch delete",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items?page=0&size=10",
            "description": "서버를 재시작하고 준비 요청부터 순서대로 진행한 뒤, 마지막 목록이 비었는지 확인한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"All practice items are deleted\", function () {",
                  "    const page = pm.response.json().data;",
                  "    pm.expect(page.total).to.eql(0);",
                  "    pm.expect(page.items).to.eql([]);",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "구현한 API는 8개다. 수정과 삭제 후 결과를 다시 확인하는 GET 요청 4개를 포함해 이 폴더의 요청은 총 12개다."
    },
    {
      "name": "2 - Error responses",
      "item": [
        {
          "name": "400 - Invalid input",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \" \",\n  \"price\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "404 - Missing item",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "500 - Demo internal error",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Demo-Error",
                "value": "500",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 500\", function () { pm.response.to.have.status(500); });"
                ]
              }
            }
          ]
        },
        {
          "name": "503 - Demo unavailable",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Demo-Error",
                "value": "503",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 503\", function () { pm.response.to.have.status(503); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
