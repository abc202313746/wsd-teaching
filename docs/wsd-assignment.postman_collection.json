{
  "info": {
    "name": "WSD Backend Assignment - 8 APIs",
    "description": "과제 공지 기준: HTTP 메서드별 2개 API, 공통 응답 형식, 요청 로그, 200/201/400/404/500/503 검증. 서버를 실행한 후 폴더 순서대로 실행하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "headerItemId",
      "value": ""
    },
    {
      "key": "fixtureId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Standard response envelope\", function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.keys(\"status\", \"data\");",
          "    pm.expect(body.status).to.eql(pm.response.code < 400 ? \"success\" : \"error\");",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 - Setup",
      "item": [
        {
          "name": "Create batch-delete fixture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Milk\",\n  \"price\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"fixtureId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 - Eight APIs",
      "item": [
        {
          "name": "POST 1 - Create item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coffee\",\n  \"price\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"itemId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST 2 - Create with headers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-USER-ID",
                "value": "student01"
              },
              {
                "key": "Authorization",
                "value": "Bearer demo-token"
              }
            ],
            "url": "{{baseUrl}}/api/v3/items/with-header",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tea\",\n  \"price\": 2000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"headerItemId\", pm.response.json().data.item.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET 1 - Search and list",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items?keyword=Coffee&page=0&size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET 2 - Read item",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items/{{itemId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT 1 - Replace item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items/{{itemId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Americano\",\n  \"price\": 1800\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT 2 - Replace price",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items/{{itemId}}/price",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 2200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE 1 - Delete item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items/{{headerItemId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE 2 - Delete selected items",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items?ids={{itemId}},{{fixtureId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Error responses",
      "item": [
        {
          "name": "400 - Invalid input",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \" \",\n  \"price\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "404 - Missing item",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/items/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "500 - Demo internal error",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Demo-Error",
                "value": "500"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 500\", function () { pm.response.to.have.status(500); });"
                ]
              }
            }
          ]
        },
        {
          "name": "503 - Demo unavailable",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Demo-Error",
                "value": "503"
              }
            ],
            "url": "{{baseUrl}}/api/v1/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 503\", function () { pm.response.to.have.status(503); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
